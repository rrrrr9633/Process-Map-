# AI 大模型配置
AI_MODEL_PROVIDER=deepseek  # 可选: deepseek, openai, azure, custom
AI_API_KEY=
AI_API_BASE=http://new.zhushouzl.cloud/v1
AI_MODEL_NAME=gpt-5.5
AI_TIMEOUT_SECONDS=500

# OCR 服务配置（可选）
OCR_PROVIDER=none  # 可选: none, baidu, aliyun, tencent, custom
OCR_API_KEY=
OCR_API_SECRET=

# 多模态视觉识别配置（可选）
VISION_PROVIDER=none  # 可选: none, openai, qwen, custom
VISION_API_KEY=
VISION_API_BASE=

# Agent 配置
AGENT_ENABLED=true
AGENT_MAX_IMAGES=6
AGENT_MAX_PDF_TEXT_CHARS=12000
AGENT_GOAL=根据 PDF 图纸中的复杂图片和标注拆分为可执行工艺流程图

# 应用配置
APP_ENV=development
DEBUG=true

# 数据存储路径
ARCHIVE_PATH=./archives
KNOWLEDGE_BASE_PATH=./knowledge_base
